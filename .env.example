# Copy this file to .env before running Docker Compose.
APP_ENV=development
APP_SECRET=replace-with-a-random-secret-at-least-32-characters-long

MYSQL_ROOT_PASSWORD=local-root-change-this
DB_NAME=gate_pass
DB_USER=gate_pass_user
DB_PASSWORD=local-db-change-this
MYSQL_PORT=3306
FRONTEND_PORT=8080

# console prints the code to backend logs for local learning.
# Set OTP_DELIVERY=smtp and provide SMTP values to deliver real email.
OTP_DELIVERY=console
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASS_TTL_HOURS=8
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

CORS_ORIGINS=http://localhost:8080
